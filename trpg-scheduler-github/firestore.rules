rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.kind in ['single', 'weekly'];
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      match /availability/{userId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 24
          && request.resource.data.slots is list
          && request.resource.data.slots.size() >= 1
          && request.resource.data.slots.size() <= 30;
      }
    }
  }
}
